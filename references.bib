@book{sienaMetodologiaPesquisaCientifica2024,
  title = {{Metodologia da Pesquisa Cient{\'i}fica e Elementos para Elabora{\c c}{\~a}o e Apresenta{\c c}{\~a}o de Trabalhos Acad{\^e}micos}},
  author = {Siena, Osmar and Braga, Aurineide Alves and Oliveira, Cl{\'e}sia Maria De and Carvalho, Erasmo Moreira De},
  year = {2024},
  month = jul,
  publisher = {Editora Poisson},
  doi = {10.36229/978-65-5866-411-6},
  urldate = {2025-08-31},
  abstract = {Adentrar no universo da pesquisa cient{\'i}fica e da produ{\c c}{\~a}o textual acad{\^e}mica pode ser uma jornada {\'a}rdua, repleta de desafios e incertezas. Mas, com o guia adequado, essa jornada pode se transformar o processo de constru{\c c}{\~a}o do conhecimento em uma experi{\^e}ncia enriquecedora de aprendizado e descobertas. Este livro se prop{\~o}e a ser esse guia, conduzindo o leitor por uma caminhada imersiva pelos meandros da pesquisa cient{\'i}fica e da escrita acad{\^e}mica. Por meio uma linguagem clara, objetiva e acess{\'i}vel, a obra desvenda os segredos da metodologia cient{\'i}fica, desde os conceitos b{\'a}sicos at{\'e} as normas mais recentes para formata{\c c}{\~a}o de trabalhos. O foco principal est{\'a} no processo de produ{\c c}{\~a}o dos trabalhos acad{\^e}micos mais comuns na vida universit{\'a}ria, com {\^e}nfase nos m{\'e}todos e t{\'e}cnicas de pesquisa e nas normas para elabora{\c c}{\~a}o e apresenta{\c c}{\~a}o de trabalhos acad{\^e}micos, de forma a oferecer subs{\'i}dios ao desenvolvimento da comunica{\c c}{\~a}o escrita na universidade e contribuir para o dom{\'i}nio da ci{\^e}ncia, uma das finalidades da gradua{\c c}{\~a}o e p{\'o}s-gradua{\c c}{\~a}o. Estruturado em oito cap{\'i}tulos, cada etapa do processo {\'e} devidamente apresentada e discutida.  A primeira etapa explora as caracter{\'i}sticas, tipos e fun{\c c}{\~o}es de diferentes modalidades de trabalhos acad{\^e}micos, desde resumos e artigos at{\'e} monografias e disserta{\c c}{\~o}es. A segunda etapa dessa jornada embarca em uma viagem pelo tempo, revisitando a evolu{\c c}{\~a}o da ci{\^e}ncia e contextualizando o papel da pesquisa na constru{\c c}{\~a}o do conhecimento. Desvenda os fundamentos da pesquisa cient{\'i}fica, discute concep{\c c}{\~o}es paradigm{\'a}ticas, explora as diferentes abordagens metodol{\'o}gicas, conceitos como m{\'e}todos, estrat{\'e}gias e t{\'e}cnicas de pesquisa. A terceira etapa convida o leitor a conhecer o projeto de pesquisa, as etapas de sua elabora{\c c}{\~a}o, que compreendem a defini{\c c}{\~a}o do tema, a problematiza{\c c}{\~a}o, a formula{\c c}{\~a}o da pergunta de pesquisa, a explicita{\c c}{\~a}o a relev{\^a}ncia do trabalho proposto, a revis{\~a}o da literatura e as defini{\c c}{\~o}es e descri{\c c}{\~o}es dos aspectos metodol{\'o}gicas. Na quarta e quintas etapas, a jornada prossegue com as normas da Associa{\c c}{\~a}o Brasileira de Normas T{\'e}cnicas (ABNT) que estabelecem padr{\~o}es para a formata{\c c}{\~a}o e apresenta{\c c}{\~a}o dos trabalhos acad{\^e}micos. A quinta etapa, especificamente, contempla tamb{\'e}m as formas adequadas de realizar cita{\c c}{\~o}es, escrever as refer{\^e}ncias, bem como as maneiras corretas de apresenta{\c c}{\~a}o de ilustra{\c c}{\~o}es e tabelas. A partir dessas normativas {\'e} poss{\'i}vel estruturar diferentes tipos de trabalhos, desde resumos e artigos cient{\'i}ficos at{\'e} monografias e disserta{\c c}{\~o}es, al{\'e}m de organizar as ideias de forma clara e concisa, utilizar a linguagem adequada e formata{\c c}{\~a}o correta cada elemento do trabalho. Para aprimorar a pr{\'a}tica da formata{\c c}{\~a}o e elabora{\c c}{\~a}o do texto, o livro oferece na sexta etapa um tutorial completo no Word, com instru{\c c}{\~o}es passo a passo para a elabora{\c c}{\~a}o de cada elemento de um trabalho acad{\^e}mico. Dicas e exemplos pr{\'a}ticos complementam o aprendizado, tornando a formata{\c c}{\~a}o um processo mais {\'a}gil e eficiente. As revistas e/ou peri{\'o}dicos cient{\'i}ficos e comit{\^e}s de eventos exigem no todo ou em parte a utiliza{\c c}{\~a}o das Normas da American Psychological Association (APA) para formata{\c c}{\~a}o dos trabalhos. Por isso, o livro tamb{\'e}m contempla na etapa s{\'e}tima os elementos essenciais das referidas Normas. O livro tamb{\'e}m oferece um roteiro com as normas e diretrizes para publica{\c c}{\~a}o em peri{\'o}dicos cient{\'i}ficos e possibilita o preparo para submeter os trabalhos {\`a} avalia{\c c}{\~a}o da comunidade cient{\'i}fica. Aprende-se a formatar os trabalhos de acordo com as exig{\^e}ncias das revistas, a elaborar refer{\^e}ncias bibliogr{\'a}ficas precisas e a seguir as boas pr{\'a}ticas de publica{\c c}{\~a}o cient{\'i}fica. "Metodologia da Pesquisa Cient{\'i}fica e Elementos para Elabora{\c c}{\~a}o e Apresenta{\c c}{\~a}o de Trabalhos Acad{\^e}micos" {\'e} mais do que um livro. {\'E} um guia para estudantes, pesquisadores e profissionais que desejam aprimorar suas habilidades na produ{\c c}{\~a}o de conhecimento cient{\'i}fico. Por meio de uma abordagem abrangente, acess{\'i}vel e pr{\'a}tica, a obra oferece as ferramentas necess{\'a}rias para navegar com seguran{\c c}a no mundo da pesquisa e da escrita acad{\^e}mica.    Os Autores},
  isbn = {978-65-5866-411-6},
  langid = {portuguese},
  file = {C:\Users\User\Zotero\storage\KAEQTIRV\Siena et al. - 2024 - Metodologia da Pesquisa Científica e Elementos para Elaboração e Apresentação de Trabalhos Acadêmico.pdf}
}

