@inproceedings{ginigeEffectiveOnlineLearning2022a,
  title = {Effective Online Learning Management System to Improve and Enhance the Online Learning and Student Engagement Experience.: {{This}} Document Contains How the Proposed Solution, an Extension, Can Help Enhance Distance Learning.},
  shorttitle = {Effective Online Learning Management System to Improve and Enhance the Online Learning and Student Engagement Experience.},
  booktitle = {Proceedings of the 6th {{International Conference}} on {{Information System}} and {{Data Mining}}},
