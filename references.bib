@article{baldanRepresentacaoAtoEnsinar2011,
  title = {{A representa{\c c}{\~a}o do ato de ensinar: continuidades e rupturas da concep{\c c}{\~a}o de ensino na pedagogia tradicional, na psicologia hist{\'o}rico-cultural e na pedagogia hist{\'o}rico-cr{\'i}tica : uma an{\'a}lise a partir das teses e disserta{\c c}{\~o}es no Portal da CAPES}},
  shorttitle = {{A representa{\c c}{\~a}o do ato de ensinar}},
  author = {Baldan, Merilin [UNESP},
  year = {2011},
  month = feb,
  eprint = {11449/90243},
  eprinttype = {hdl},
  publisher = {Universidade Estadual Paulista (Unesp)},
  url = {http://hdl.handle.net/11449/90243},
  urldate = {2025-09-13},
  abstract = {Ao estudar a hist{\'o}ria da educa{\c c}{\~a}o e a hist{\'o}ria das ideias pedag{\'o}gicas observamos no s{\'e}culo XX o embate entre o tradicional e o inovador. A cr{\'i}tica promulgada pela Escola Nova contra o Ensino Tradicional denota aspecto negativo do ato de ensinar e, invariavelmente, as ideias pedag{\'o}gicas que defendem o ato de ensinar s{\~a}o aproximadas com o termo ``tradicional''. As correntes pedag{\'o}gicas que defendem o ato de ensinar, dentre elas: a Pedagogia Tradicional (PT), a Psicologia Hist{\'o}rico-Cultural (PsHC) e a Pedagogia Hist{\'o}rico-Cr{\'i}tica (PsHC); tem sido alvo de compara{\c c}{\~o}es e de cr{\'i}ticas pelos movimentos contempor{\^a}neos que fazem a cr{\'i}tica ao ensino, denominando-as, sob o julgo negativo do termo ``tradicional''. Assim algumas quest{\~o}es t{\^e}m nos inquietado: Seria poss{\'i}vel que a aproxima{\c c}{\~a}o entre a PT, a PsHC e a PeHC? Em que medida h{\'a} aproxima{\c c}{\~o}es e rupturas nas ideias pedag{\'o}gicas? Quais os interesses em aproxim{\'a}-las ou em distanci{\'a}-las? O objetivo geral foi de analisar a defesa do ato de ensinar da PT, da PsHC e da PeHC presente na hist{\'o}ria das ideias pedag{\'o}gicas. Para tal, utilizamos como categorias de an{\'a}lise a concep{\c c}{\~a}o de sociedade, concep{\c c}{\~a}o de homem, concep{\c c}{\~a}o de educa{\c c}{\~a}o, concep{\c c}{\~a}o do ato de ensinar (processo de ensino aprendizagem), concep{\c c}{\~a}o de professor e concep{\c c}{\~a}o de aluno. Os objetivos espec{\'i}ficos foram (a) investigar a representa{\c c}{\~a}o do ato de ensinar das correntes pedag{\'o}gicas nas teses e disserta{\c c}{\~o}es presentes no portal da CAPES e (b) analisar a rela{\c c}{\~a}o entre o ``tradicional'' e o ``moderno'' na constru{\c c}{\~a}o hist{\'o}rica das ideias pedag{\'o}gicas. O referencial te{\'o}ricometodol{\'o}gico ancora-se na hist{\'o}ria das ideias pedag{\'o}gicas, articulando o materialismo hist{\'o}rico-dial{\'e}tico e as contribui{\c c}{\~o}es da Escola dos Annales. A revis{\~a}o bibliogr{\'a}fica compreendeu o levantamento e a an{\'a}lise de vinte e uma produ{\c c}{\~o}es acad{\^e}micocient{\'i}ficas...},
  langid = {portuguese},
  file = {C:\Users\User\Zotero\storage\CFIVVFN6\Baldan - 2011 - A representação do ato de ensinar continuidades e rupturas da concepção de ensino na pedagogia trad.pdf}
}

