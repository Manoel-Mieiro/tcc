@article{valenteTECNOLOGIASEDUCACAODISTANCIA2019,
  title = {{TECNOLOGIAS E EDUCA{\c C}{\~A}O A DIST{\^A}NCIA NO ENSINO SUPERIOR : USO DE METODOLOGIAS ATIVAS NA GRADUA{\c C}{\~A}O}},
  shorttitle = {{TECNOLOGIAS E EDUCA{\c C}{\~A}O A DIST{\^A}NCIA NO ENSINO SUPERIOR}},
  author = {Valente, Jos{\'e} Armando},
  year = {2019},
